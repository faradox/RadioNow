RADIONOW_GEMINI_API_KEY=your_gemini_api_key
RADIONOW_ANTHROPIC_API_KEY=your_anthropic_api_key
RADIONOW_REPLICATE_API_TOKEN=your_replicate_api_token
RADIONOW_PORT=8090
# Script LLM used when nothing is chosen in the UI: gemini | claude
# RADIONOW_DEFAULT_LLM=gemini
# RADIONOW_GEMINI_MODEL=gemini-4-argon
# RADIONOW_CLAUDE_MODEL=claude-opus-5-5
# RADIONOW_MINIMAX_TTS_MODEL=minimax/speech-2.8-hd
# Voice-cloning target family; must be one minimax/voice-cloning accepts
# RADIONOW_MINIMAX_CLONE_TARGET=speech-2.6-hd
# Daily morning broadcast defaults (editable in /admin?tab=daily)
# RADIONOW_DAILY_ENABLED=true
# RADIONOW_DAILY_TIME=06:00
# Override the news feeds: "Label|url|world-or-light" separated by ';'
# RADIONOW_NEWS_FEEDS=
# Replicate prices (USD) per model: per_char:<rate> | per_second:<rate> | per_run:<price>
# RADIONOW_REPLICATE_PRICES={"qwen/qwen3-tts": "per_second:0.001525", "minimax/voice-cloning": "per_run:3.00"}
# Optional: override MongoDB connection string
# RADIONOW_MONGO_URL=mongodb://mongodb:27017/
